+@pytest.mark.asyncio
+async def test_logical_output_acknowledgement_is_exact() -> None:
+    events, _ = await _publish_generation("output-1", 3, ["A"], complete=True)
+    reconstructor = LogicalOutputReconstructor("output-1", result_type=str)
+    result = None
+    for offset, event in enumerate(events, start=20):
+        result = reconstructor.apply(WorkflowStreamItem("events", event, offset)).result
+    assert result is not None
+
+    acknowledgement = result.acknowledgement
+    observed_terminal = WorkflowStreamItem(
+        "events", events[-1], acknowledgement.terminal_offset
+    )
+    result.terminal.validate_acknowledgement(
+        acknowledgement, observed_terminal=observed_terminal
+    )
+    mutations = [
+        replace(acknowledgement, logical_output_id="other"),
+        replace(acknowledgement, generation=2),
+        replace(acknowledgement, terminal_sequence=99),
+        replace(acknowledgement, terminal_offset=99),
+        replace(acknowledgement, content_sha256="f" * 64),
+        replace(acknowledgement, publisher_id="other"),
+    ]
+    for mutation in mutations:
+        with pytest.raises(LogicalOutputProtocolError, match="acknowledgement"):
+            result.validate_acknowledgement(mutation)
+        with pytest.raises(LogicalOutputProtocolError, match="acknowledgement"):
+            result.terminal.validate_acknowledgement(
+                mutation, observed_terminal=observed_terminal
+            )
+
