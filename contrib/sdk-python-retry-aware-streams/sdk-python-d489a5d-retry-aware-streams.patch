+@pytest.mark.asyncio
+async def test_workflow_validates_acknowledged_terminal_at_exact_stream_offset(
+    client: Client,
+) -> None:
+    workflow_id = f"logical-output-ack-{uuid.uuid4()}"
+    async with new_worker(client, ExactLogicalOutputAckWorkflow) as worker:
+        handle = await client.start_workflow(
+            ExactLogicalOutputAckWorkflow.run,
+            id=workflow_id,
+            task_queue=worker.task_queue,
+            execution_timeout=timedelta(seconds=30),
+        )
+        stream = WorkflowStreamClient.create(client, workflow_id)
+        output = stream.logical_output_publisher(
+            "events",
+            logical_output_id=f"{workflow_id}/output",
+            generation=1,
+            type=str,
+        )
+        output.publish("A")
+        terminal = output.complete()
+        await stream.flush()
+
+        reconstructor = stream.logical_output_reconstructor(
+            f"{workflow_id}/output", result_type=str
+        )
+        result = None
+        async for item in stream.subscribe(
+            "events",
+            result_type=LogicalOutputEvent,
+            poll_cooldown=timedelta(milliseconds=10),
+        ):
+            result = reconstructor.apply(item).result
+            if result is not None:
+                break
+        assert result is not None
+
+        with pytest.raises(WorkflowUpdateFailedError):
+            await handle.execute_update(
+                ExactLogicalOutputAckWorkflow.acknowledge,
+                (
+                    terminal,
+                    replace(
+                        result.acknowledgement,
+                        terminal_offset=result.terminal_offset - 1,
+                    ),
+                ),
+            )
+        await handle.execute_update(
+            ExactLogicalOutputAckWorkflow.acknowledge,
+            (terminal, result.acknowledgement),
+        )
+        await handle.result()
+
