+@pytest.mark.asyncio
+async def test_logical_output_publisher_rejects_invalid_lifecycle() -> None:
+    handle = CapturingHandle()
+    client = WorkflowStreamClient(handle)  # type: ignore[arg-type]
+
+    with pytest.raises(ValueError, match="logical_output_id"):
+        client.logical_output_publisher(
+            "events", logical_output_id="", generation=1, type=str
+        )
+    with pytest.raises(ValueError, match="generation"):
+        client.logical_output_publisher(
+            "events", logical_output_id="output", generation=0, type=str
+        )
+
+    publisher = client.logical_output_publisher(
+        "events", logical_output_id="output", generation=1, type=str
+    )
+    publisher.publish("A")
+    publisher.complete()
+    with pytest.raises(LogicalOutputProtocolError, match="already complete"):
+        publisher.publish("B")
+    with pytest.raises(LogicalOutputProtocolError, match="already complete"):
+        publisher.complete()
