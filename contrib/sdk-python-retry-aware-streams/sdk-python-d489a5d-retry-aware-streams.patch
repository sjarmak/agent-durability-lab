+@pytest.mark.asyncio
+async def test_logical_output_rejects_wrong_identity_sequence_and_terminal() -> None:
+    events, _ = await _publish_generation("output-1", 1, ["A"], complete=True)
+
+    wrong_id = LogicalOutputReconstructor("expected", result_type=str)
