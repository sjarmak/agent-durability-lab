new file mode 100644
index 0000000000000000000000000000000000000000..aa28199b8958acb4faa086f268bde75eebd9c32d
--- /dev/null
+++ b/temporalio/contrib/workflow_streams/_logical_output.py
@@ -0,0 +1,510 @@
+"""Retry-aware logical output protocol built on Workflow Streams."""
+
+from __future__ import annotations
+
+import binascii
+import hashlib
+from collections.abc import Callable
+from dataclasses import dataclass
+from enum import StrEnum
+from typing import Any, Generic, TypeVar
+
+from google.protobuf.message import DecodeError
+
+from temporalio.api.common.v1 import Payload
+from temporalio.converter import DataConverter, PayloadConverter
+
+from ._types import WorkflowStreamItem, _decode_payload, _encode_payload
+
+T = TypeVar("T")
+
+_PROTOCOL_VERSION = 1
+
+
+class LogicalOutputEventKind(StrEnum):
+    """Structural event kinds in one logical output generation."""
+
+    BEGIN = "begin"
+    CHUNK = "chunk"
+    COMPLETE = "complete"
+
+
+@dataclass(frozen=True)
+class LogicalOutputEvent:
+    """Wire envelope for one retry-aware logical output event.
+
+    publisher_id identifies one delivery process. logical_output_id identifies
+    the application output across replacement publishers, while generation
+    fences an older publisher after a retry.
+    """
+
+    logical_output_id: str
+    generation: int
+    sequence: int
+    publisher_id: str
+    kind: LogicalOutputEventKind
+    activity_attempt: int | None = None
+    chunk_index: int | None = None
+    data: str = ""
+    chunk_count: int | None = None
+    content_sha256: str = ""
+    protocol_version: int = _PROTOCOL_VERSION
+
+
+@dataclass(frozen=True)
+class LogicalOutputTerminal:
+    """Publisher receipt for a completed logical output generation."""
+
+    topic: str
+    logical_output_id: str
+    generation: int
+    terminal_sequence: int
+    chunk_count: int
+    content_sha256: str
+    publisher_id: str
+
+    def validate_acknowledgement(
+        self,
+        acknowledgement: LogicalOutputAcknowledgement,
+        *,
+        observed_terminal: WorkflowStreamItem[LogicalOutputEvent],
+    ) -> None:
+        """Reject an acknowledgement not bound to this observed terminal."""
+        expected = (
+            self.topic,
+            self.logical_output_id,
+            self.generation,
+            self.terminal_sequence,
+            self.chunk_count,
+            self.content_sha256,
+            self.publisher_id,
+        )
+        actual = (
+            acknowledgement.topic,
+            acknowledgement.logical_output_id,
+            acknowledgement.generation,
+            acknowledgement.terminal_sequence,
+            acknowledgement.chunk_count,
+            acknowledgement.content_sha256,
+            acknowledgement.publisher_id,
+        )
+        event = observed_terminal.data
+        observed = (
+            observed_terminal.topic,
+            event.logical_output_id,
+            event.generation,
+            event.sequence,
+            event.chunk_count,
+            event.content_sha256,
+            event.publisher_id,
+        )
+        if (
+            actual != expected
+            or acknowledgement.terminal_offset != observed_terminal.offset
+            or observed != expected
+            or event.kind is not LogicalOutputEventKind.COMPLETE
+            or event.chunk_index is not None
+            or bool(event.data)
+        ):
+            raise LogicalOutputProtocolError(
+                "logical output acknowledgement does not match the successful "
+                "observed terminal generation, sequence, offset, hash, and publisher"
+            )
+
+
+@dataclass(frozen=True)
+class LogicalOutputAcknowledgement:
+    """Consumer acknowledgement of one exact observed terminal event."""
+
+    topic: str
+    logical_output_id: str
+    generation: int
+    terminal_sequence: int
+    terminal_offset: int
+    chunk_count: int
+    content_sha256: str
+    publisher_id: str
+
+
+class LogicalOutputProtocolError(ValueError):
+    """A logical output event or acknowledgement violated the protocol."""
+
+
+@dataclass(frozen=True)
+class LogicalOutputResult(Generic[T]):
+    """A fully reconstructed logical output and its observed terminal."""
+
+    items: tuple[T, ...]
+    terminal: LogicalOutputTerminal
+    terminal_offset: int
+
+    @property
+    def acknowledgement(self) -> LogicalOutputAcknowledgement:
+        """Return an acknowledgement bound to this exact terminal observation."""
+        return LogicalOutputAcknowledgement(
+            topic=self.terminal.topic,
+            logical_output_id=self.terminal.logical_output_id,
+            generation=self.terminal.generation,
+            terminal_sequence=self.terminal.terminal_sequence,
+            terminal_offset=self.terminal_offset,
+            chunk_count=self.terminal.chunk_count,
+            content_sha256=self.terminal.content_sha256,
+            publisher_id=self.terminal.publisher_id,
+        )
+
+    def validate_acknowledgement(
+        self, acknowledgement: LogicalOutputAcknowledgement
+    ) -> None:
+        """Reject an acknowledgement for anything but this exact terminal."""
+        if acknowledgement != self.acknowledgement:
+            raise LogicalOutputProtocolError(
+                "logical output acknowledgement does not match the exact "
+                "terminal generation, sequence, offset, hash, and publisher"
+            )
+
+
+@dataclass(frozen=True)
+class LogicalOutputUpdate(Generic[T]):
+    """One validated incremental update to a reconstructed logical output.
+
+    A begin update tells consumers to discard chunks rendered for an older
+    generation. A chunk update carries the newly decoded value, and a complete
+    update carries the final result and exact acknowledgement receipt.
+    """
+
+    kind: LogicalOutputEventKind
+    logical_output_id: str
+    generation: int
+    sequence: int
+    publisher_id: str
+    activity_attempt: int | None
+    offset: int
+    chunk: T | None = None
+    result: LogicalOutputResult[T] | None = None
+
+
+def _update_content_hash(hasher: Any, payload: Payload) -> None:
+    encoded = payload.SerializeToString()
+    # Length-prefix each payload so different chunk boundaries cannot hash to
+    # the same byte concatenation.
+    hasher.update(len(encoded).to_bytes(8, "big"))
+    hasher.update(encoded)
+
+
+class LogicalOutputPublisher(Generic[T]):
+    """Publish one fenced logical output generation.
+
+    Create this with WorkflowStreamClient.logical_output_publisher, then
+    publish chunks and call complete. Construction emits the structural begin
+    event, so a replacement Activity generation explicitly resets a consumer.
+    """
+
+    def __init__(
+        self,
+        *,
+        topic: str,
+        logical_output_id: str,
+        generation: int,
+        publisher_id: str,
+        activity_attempt: int | None,
+        payload_converter: PayloadConverter,
+        publish_event: Callable[[LogicalOutputEvent], None],
+    ) -> None:
+        """Initialize one generation and emit its begin event."""
+        if not logical_output_id.strip():
+            raise ValueError("logical_output_id must be non-empty")
+        if type(generation) is not int or generation < 1:
+            raise ValueError("generation must be a positive integer")
+        if not publisher_id:
+            raise ValueError("publisher_id must be non-empty")
+        if activity_attempt is not None and (
+            type(activity_attempt) is not int or activity_attempt < 1
+        ):
+            raise ValueError("activity_attempt must be a positive integer")
+        self._topic = topic
+        self._logical_output_id = logical_output_id
+        self._generation = generation
+        self._publisher_id = publisher_id
+        self._activity_attempt = activity_attempt
+        self._payload_converter = payload_converter
+        self._publish_event = publish_event
+        self._chunk_count = 0
+        self._hasher = hashlib.sha256()
+        self._complete = False
+        self._publish_event(self._event(LogicalOutputEventKind.BEGIN, sequence=0))
+
+    def publish(self, value: T) -> None:
+        """Publish the next typed chunk in this generation."""
+        self._require_open()
+        payload: Payload
+        if isinstance(value, Payload):
+            payload = value
+        else:
+            payload = self._payload_converter.to_payloads([value])[0]
+        chunk_index = self._chunk_count
+        sequence = chunk_index + 1
+        event = self._event(
+            LogicalOutputEventKind.CHUNK,
+            sequence=sequence,
+            chunk_index=chunk_index,
+            data=_encode_payload(payload),
+        )
+        self._publish_event(event)
+        _update_content_hash(self._hasher, payload)
+        self._chunk_count += 1
+
+    def complete(self) -> LogicalOutputTerminal:
+        """Publish a terminal event and return its generation-bound receipt."""
+        self._require_open()
+        sequence = self._chunk_count + 1
+        content_sha256 = self._hasher.hexdigest()
+        self._publish_event(
+            self._event(
+                LogicalOutputEventKind.COMPLETE,
+                sequence=sequence,
+                chunk_count=self._chunk_count,
+                content_sha256=content_sha256,
+            )
+        )
+        self._complete = True
+        return LogicalOutputTerminal(
+            topic=self._topic,
+            logical_output_id=self._logical_output_id,
+            generation=self._generation,
+            terminal_sequence=sequence,
+            chunk_count=self._chunk_count,
+            content_sha256=content_sha256,
+            publisher_id=self._publisher_id,
+        )
+
+    def _event(
+        self,
+        kind: LogicalOutputEventKind,
+        *,
+        sequence: int,
+        chunk_index: int | None = None,
+        data: str = "",
+        chunk_count: int | None = None,
+        content_sha256: str = "",
+    ) -> LogicalOutputEvent:
+        return LogicalOutputEvent(
+            logical_output_id=self._logical_output_id,
+            generation=self._generation,
+            sequence=sequence,
+            publisher_id=self._publisher_id,
+            kind=kind,
+            activity_attempt=self._activity_attempt,
+            chunk_index=chunk_index,
+            data=data,
+            chunk_count=chunk_count,
+            content_sha256=content_sha256,
+        )
+
+    def _require_open(self) -> None:
+        if self._complete:
+            raise LogicalOutputProtocolError(
+                "logical output generation is already complete"
+            )
+
+
+class LogicalOutputReconstructor(Generic[T]):
+    """Validate and reconstruct one logical output across publisher retries."""
+
+    def __init__(
+        self,
+        logical_output_id: str,
+        *,
+        result_type: type[T],
+        payload_converter: PayloadConverter | None = None,
+    ) -> None:
+        """Initialize a reconstructor for one stable logical output ID."""
+        if not logical_output_id.strip():
+            raise ValueError("logical_output_id must be non-empty")
+        self._logical_output_id = logical_output_id
+        self._result_type = result_type
+        self._payload_converter = (
+            payload_converter or DataConverter.default.payload_converter
+        )
+        self._generation: int | None = None
+        self._publisher_id: str | None = None
+        self._topic: str | None = None
+        self._activity_attempt: int | None = None
+        self._items: list[T] = []
+        self._hasher = hashlib.sha256()
+        self._complete = False
+
+    def apply(
+        self, item: WorkflowStreamItem[LogicalOutputEvent]
+    ) -> LogicalOutputUpdate[T]:
+        """Apply one item and return its validated incremental update."""
+        event = item.data
+        self._validate_common(event)
+        if event.kind is LogicalOutputEventKind.BEGIN:
+            self._apply_begin(item.topic, event)
+            chunk = None
+            result = None
+        else:
+            self._validate_current(item.topic, event)
+            if self._complete:
+                raise LogicalOutputProtocolError(
+                    "logical output generation is already complete"
+                )
+            if event.kind is LogicalOutputEventKind.CHUNK:
+                chunk = self._apply_chunk(event)
+                result = None
+            elif event.kind is LogicalOutputEventKind.COMPLETE:
+                chunk = None
+                result = self._apply_complete(item.offset, event)
+            else:
+                raise LogicalOutputProtocolError(
+                    f"unknown logical output event kind {event.kind!r}"
+                )
+        return LogicalOutputUpdate(
+            kind=event.kind,
+            logical_output_id=event.logical_output_id,
+            generation=event.generation,
+            sequence=event.sequence,
+            publisher_id=event.publisher_id,
+            activity_attempt=event.activity_attempt,
+            offset=item.offset,
+            chunk=chunk,
+            result=result,
+        )
+
+    def _validate_common(self, event: LogicalOutputEvent) -> None:
+        if event.protocol_version != _PROTOCOL_VERSION:
+            raise LogicalOutputProtocolError(
+                f"unsupported logical output protocol version {event.protocol_version}"
+            )
+        if event.logical_output_id != self._logical_output_id:
+            raise LogicalOutputProtocolError(
+                "logical output ID differs from the reconstructor"
+            )
+        if type(event.generation) is not int or event.generation < 1:
+            raise LogicalOutputProtocolError("generation must be a positive integer")
+        if type(event.sequence) is not int or event.sequence < 0:
+            raise LogicalOutputProtocolError("sequence must be a nonnegative integer")
+        if not event.publisher_id:
+            raise LogicalOutputProtocolError("publisher_id must be non-empty")
+        if event.activity_attempt is not None and (
+            type(event.activity_attempt) is not int or event.activity_attempt < 1
+        ):
+            raise LogicalOutputProtocolError(
+                "activity attempt must be a positive integer"
+            )
+
+    def _apply_begin(self, topic: str, event: LogicalOutputEvent) -> None:
+        if (
+            event.sequence != 0
+            or event.chunk_index is not None
+            or event.data
+            or event.chunk_count is not None
+            or event.content_sha256
+        ):
+            raise LogicalOutputProtocolError(
+                "begin event has invalid structural fields"
+            )
+        if self._generation is not None:
+            if event.generation < self._generation:
+                raise LogicalOutputProtocolError(
+                    f"stale generation {event.generation}; current generation "
+                    f"is {self._generation}"
+                )
+            if event.generation == self._generation:
+                if event.publisher_id != self._publisher_id:
+                    raise LogicalOutputProtocolError(
+                        "competing publisher attempted the current generation"
+                    )
+                raise LogicalOutputProtocolError(
+                    "sequence 0 was repeated in the current generation"
+                )
+        self._generation = event.generation
+        self._publisher_id = event.publisher_id
+        self._topic = topic
+        self._activity_attempt = event.activity_attempt
+        self._items = []
+        self._hasher = hashlib.sha256()
+        self._complete = False
+
+    def _validate_current(self, topic: str, event: LogicalOutputEvent) -> None:
+        if self._generation is None:
+            raise LogicalOutputProtocolError(
+                "logical output generation did not begin before data"
+            )
+        if event.generation < self._generation:
+            raise LogicalOutputProtocolError(
+                f"stale generation {event.generation}; current generation "
+                f"is {self._generation}"
+            )
+        if event.generation > self._generation:
+            raise LogicalOutputProtocolError(
+                "logical output generation did not begin before data"
+            )
+        if event.publisher_id != self._publisher_id:
+            raise LogicalOutputProtocolError(
+                "competing publisher attempted the current generation"
+            )
+        if topic != self._topic:
+            raise LogicalOutputProtocolError("logical output topic changed")
+        if event.activity_attempt != self._activity_attempt:
+            raise LogicalOutputProtocolError(
+                "activity attempt changed within one logical output generation"
+            )
+        expected_sequence = len(self._items) + 1
+        if event.sequence != expected_sequence:
+            raise LogicalOutputProtocolError(
+                f"logical output sequence {event.sequence} does not match "
+                f"expected {expected_sequence}"
+            )
+
+    def _apply_chunk(self, event: LogicalOutputEvent) -> T:
+        if event.chunk_index != len(self._items):
+            raise LogicalOutputProtocolError(
+                f"chunk index {event.chunk_index} does not match "
+                f"expected {len(self._items)}"
+            )
+        if event.chunk_count is not None or event.content_sha256:
+            raise LogicalOutputProtocolError("chunk event has terminal fields")
+        if not event.data:
+            raise LogicalOutputProtocolError("chunk event lacks data")
+        try:
+            payload = _decode_payload(event.data)
+            value = self._payload_converter.from_payload(payload, self._result_type)
+        except (ValueError, TypeError, binascii.Error, DecodeError) as err:
+            raise LogicalOutputProtocolError(
+                "chunk event contains an invalid encoded payload"
+            ) from err
+        _update_content_hash(self._hasher, payload)
+        self._items.append(value)
+        return value
+
+    def _apply_complete(
+        self, terminal_offset: int, event: LogicalOutputEvent
+    ) -> LogicalOutputResult[T]:
+        if event.chunk_index is not None or event.data:
+            raise LogicalOutputProtocolError("complete event contains chunk data")
+        if event.chunk_count != len(self._items):
+            raise LogicalOutputProtocolError(
+                f"terminal chunk count {event.chunk_count} does not match "
+                f"reconstructed count {len(self._items)}"
+            )
+        expected_hash = self._hasher.hexdigest()
+        if event.content_sha256 != expected_hash:
+            raise LogicalOutputProtocolError(
+                "terminal content hash does not match reconstructed chunks"
+            )
+        self._complete = True
+        terminal = LogicalOutputTerminal(
+            topic=self._topic or "",
+            logical_output_id=event.logical_output_id,
+            generation=event.generation,
+            terminal_sequence=event.sequence,
+            chunk_count=len(self._items),
+            content_sha256=event.content_sha256,
+            publisher_id=event.publisher_id,
+        )
+        return LogicalOutputResult(
+            items=tuple(self._items),
+            terminal=terminal,
+            terminal_offset=terminal_offset,
+        )
