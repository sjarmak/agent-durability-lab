+    bad_count = LogicalOutputReconstructor("output-1", result_type=str)
+    bad_count.apply(WorkflowStreamItem("events", events[0], 0))
+    bad_count.apply(WorkflowStreamItem("events", events[1], 1))
+    with pytest.raises(LogicalOutputProtocolError, match="chunk count"):
+        bad_count.apply(
