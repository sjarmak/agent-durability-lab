+"""Behavioral contract for retry-aware logical Workflow Stream output."""
+
+from __future__ import annotations
+
+import base64
+import uuid
+from dataclasses import replace
+from datetime import timedelta
+from typing import Any
+
+import pytest
+
+from temporalio import workflow
+from temporalio.api.common.v1 import Payload
+from temporalio.client import Client, WorkflowUpdateFailedError
+from temporalio.contrib.workflow_streams import (
+    LogicalOutputAcknowledgement,
+    LogicalOutputEvent,
+    LogicalOutputEventKind,
+    LogicalOutputProtocolError,
+    LogicalOutputReconstructor,
+    LogicalOutputTerminal,
+    WorkflowStream,
+    WorkflowStreamClient,
+    WorkflowStreamItem,
+)
+from temporalio.converter import DataConverter
+from tests.helpers import new_worker
+
+
+class CapturingHandle:
+    """Minimal Workflow handle that preserves published Signal payloads."""
+
+    id = "logical-output-workflow"
+
+    def __init__(self) -> None:
+        self.signals: list[tuple[str, Any]] = []
+
+    async def signal(self, name: str, arg: Any) -> None:
+        self.signals.append((name, arg))
+
+
+@workflow.defn
+class ExactLogicalOutputAckWorkflow:
+    """Workflow that accepts only the terminal present at an acknowledged offset."""
+
+    @workflow.init
+    def __init__(self) -> None:
+        self.stream = WorkflowStream()
+        self._done = False
+
+    @workflow.run
+    async def run(self) -> None:
+        await workflow.wait_condition(lambda: self._done)
+
+    @workflow.update
+    def acknowledge(
+        self,
+        input: tuple[LogicalOutputTerminal, LogicalOutputAcknowledgement],
+    ) -> None:
+        terminal, acknowledgement = input
+        self.stream.validate_logical_output_acknowledgement(terminal, acknowledgement)
+        self._done = True
+
+
+def _decode_events(handle: CapturingHandle) -> list[LogicalOutputEvent]:
+    converter = DataConverter.default.payload_converter
+    events: list[LogicalOutputEvent] = []
+    for signal_name, publish_input in handle.signals:
+        assert signal_name == "__temporal_workflow_stream_publish"
+        for entry in publish_input.items:
+            payload = Payload()
+            payload.ParseFromString(base64.b64decode(entry.data))
+            events.append(converter.from_payload(payload, LogicalOutputEvent))
+    return events
+
+
+async def _publish_generation(
+    logical_output_id: str,
+    generation: int,
+    chunks: list[str],
+    *,
+    complete: bool,
+    attempt: int | None = None,
+) -> tuple[list[LogicalOutputEvent], Any]:
+    handle = CapturingHandle()
+    client = WorkflowStreamClient(handle)  # type: ignore[arg-type]
+    publisher = client.logical_output_publisher(
+        "events",
+        logical_output_id=logical_output_id,
+        generation=generation,
+        type=str,
+        activity_attempt=attempt,
+    )
+    for chunk in chunks:
+        publisher.publish(chunk)
+    terminal = publisher.complete() if complete else None
+    await client.flush()
+    return _decode_events(handle), terminal
+
+
+@pytest.mark.asyncio
+async def test_logical_output_reconstructs_only_the_latest_generation() -> None:
+    first, _ = await _publish_generation(
+        "output-1", 1, ["A", "B"], complete=False, attempt=1
+    )
+    replacement, published_terminal = await _publish_generation(
+        "output-1", 2, ["A", "B", "C"], complete=True, attempt=2
+    )
+
+    reconstructor = LogicalOutputReconstructor("output-1", result_type=str)
+    updates = []
+    offset = 0
+    for event in [*first, *replacement]:
+        updates.append(
+            reconstructor.apply(
+                WorkflowStreamItem(topic="events", data=event, offset=offset)
+            )
+        )
+        offset += 1
+
+    result = updates[-1].result
+    assert result is not None
+    assert result.items == ("A", "B", "C")
+    assert result.terminal == published_terminal
+    assert result.terminal_offset == offset - 1
+    assert result.acknowledgement.logical_output_id == "output-1"
+    assert result.acknowledgement.generation == 2
+    assert result.acknowledgement.terminal_offset == offset - 1
+    result.validate_acknowledgement(result.acknowledgement)
+    assert [update.kind for update in updates] == [
+        LogicalOutputEventKind.BEGIN,
+        LogicalOutputEventKind.CHUNK,
+        LogicalOutputEventKind.CHUNK,
+        LogicalOutputEventKind.BEGIN,
+        LogicalOutputEventKind.CHUNK,
+        LogicalOutputEventKind.CHUNK,
+        LogicalOutputEventKind.CHUNK,
+        LogicalOutputEventKind.COMPLETE,
+    ]
+    assert [update.chunk for update in updates if update.chunk is not None] == [
+        "A",
+        "B",
+        "A",
+        "B",
+        "C",
+    ]
+
+
+@pytest.mark.asyncio
+async def test_logical_output_preserves_delivery_and_attempt_identity() -> None:
+    events, terminal = await _publish_generation(
+        "output-identity", 7, ["chunk"], complete=True, attempt=11
+    )
+
+    assert [event.kind for event in events] == [
+        LogicalOutputEventKind.BEGIN,
+        LogicalOutputEventKind.CHUNK,
+        LogicalOutputEventKind.COMPLETE,
+    ]
+    assert [event.sequence for event in events] == [0, 1, 2]
+    assert [event.chunk_index for event in events] == [None, 0, None]
+    assert {event.logical_output_id for event in events} == {"output-identity"}
+    assert {event.generation for event in events} == {7}
+    assert {event.publisher_id for event in events} == {terminal.publisher_id}
+    assert {event.activity_attempt for event in events} == {11}
+    assert events[-1].chunk_count == 1
+    assert events[-1].content_sha256 == terminal.content_sha256
+    assert events[1].data
+
+
+@pytest.mark.asyncio
+async def test_logical_output_rejects_stale_and_competing_publishers() -> None:
+    first, _ = await _publish_generation("output-1", 1, ["old"], complete=False)
+    replacement, _ = await _publish_generation("output-1", 2, ["new"], complete=True)
+    competing, _ = await _publish_generation(
+        "output-1", 2, ["competing"], complete=True
+    )
+    reconstructor = LogicalOutputReconstructor("output-1", result_type=str)
+    reconstructor.apply(WorkflowStreamItem("events", first[0], 0))
+    reconstructor.apply(WorkflowStreamItem("events", first[1], 1))
+    reconstructor.apply(WorkflowStreamItem("events", replacement[0], 2))
+
+    with pytest.raises(LogicalOutputProtocolError, match="stale generation"):
+        reconstructor.apply(WorkflowStreamItem("events", first[1], 3))
+    with pytest.raises(LogicalOutputProtocolError, match="competing publisher"):
+        reconstructor.apply(WorkflowStreamItem("events", competing[0], 4))
+
+    # Rejections do not corrupt the accepted replacement generation.
+    result = None
+    for offset, event in enumerate(replacement[1:], start=5):
+        result = reconstructor.apply(WorkflowStreamItem("events", event, offset)).result
+    assert result is not None
+    assert result.items == ("new",)
+
