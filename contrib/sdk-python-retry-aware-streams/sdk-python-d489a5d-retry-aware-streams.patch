+        )
+
+    gap = LogicalOutputReconstructor("output-1", result_type=str)
+    gap.apply(WorkflowStreamItem("events", events[0], 0))
+    with pytest.raises(LogicalOutputProtocolError, match="sequence"):
+        gap.apply(WorkflowStreamItem("events", replace(events[1], sequence=5), 1))
