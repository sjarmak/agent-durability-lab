+@pytest.mark.asyncio
+async def test_successful_replacement_terminal_rejects_stale_attempt_ack() -> None:
+    first, _ = await _publish_generation("output-1", 1, ["stale"], complete=True)
+    replacement, replacement_terminal = await _publish_generation(
+        "output-1", 2, ["current"], complete=True
+    )
+    reconstructor = LogicalOutputReconstructor("output-1", result_type=str)
+    first_result = None
+    for offset, event in enumerate(first):
+        first_result = reconstructor.apply(
+            WorkflowStreamItem("events", event, offset)
+        ).result
+    assert first_result is not None
+
+    replacement_result = None
+    for offset, event in enumerate(replacement, start=len(first)):
+        replacement_result = reconstructor.apply(
+            WorkflowStreamItem("events", event, offset)
+        ).result
+    assert replacement_result is not None
+
+    with pytest.raises(LogicalOutputProtocolError, match="acknowledgement"):
+        replacement_terminal.validate_acknowledgement(
+            first_result.acknowledgement,
+            observed_terminal=WorkflowStreamItem(
+                "events", first[-1], first_result.terminal_offset
+            ),
+        )
+    replacement_terminal.validate_acknowledgement(
+        replacement_result.acknowledgement,
+        observed_terminal=WorkflowStreamItem(
+            "events", replacement[-1], replacement_result.terminal_offset
+        ),
+    )
