+    bad_hash = LogicalOutputReconstructor("output-1", result_type=str)
+    bad_hash.apply(WorkflowStreamItem("events", events[0], 0))
+    bad_hash.apply(WorkflowStreamItem("events", events[1], 1))
+    with pytest.raises(LogicalOutputProtocolError, match="content hash"):
+        bad_hash.apply(
