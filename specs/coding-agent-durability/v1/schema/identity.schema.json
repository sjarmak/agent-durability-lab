{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity.schema.json",
  "title": "Coding agent durability identity",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "turn_id",
    "operation_id",
    "authority"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "session_id": { "$ref": "#/$defs/stableId" },
    "turn_id": { "$ref": "#/$defs/stableId" },
    "operation_id": { "$ref": "#/$defs/stableId" },
    "effect_id": { "$ref": "#/$defs/stableId" },
    "authority": { "$ref": "#/$defs/authority" },
    "delivery": { "$ref": "#/$defs/delivery" }
  },
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"
    },
    "authority": {
      "type": "object",
      "required": ["generation", "owner_capability_digest", "status"],
      "properties": {
        "generation": { "type": "integer", "minimum": 1 },
        "owner_capability_digest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["current", "revoked"] }
      },
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "required": ["workflow_id", "workflow_run_id", "activity_id", "activity_attempt"],
      "properties": {
        "workflow_id": { "$ref": "#/$defs/stableId" },
        "workflow_run_id": { "$ref": "#/$defs/stableId" },
        "activity_id": { "$ref": "#/$defs/stableId" },
        "activity_attempt": { "type": "integer", "minimum": 1 },
        "worker_identity": { "type": "string", "minLength": 1, "maxLength": 256 },
        "process_identity": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "additionalProperties": false
    }
  }
}
